{
  "buildCommand": "node build.mjs --web",
  "outputDirectory": "dist/web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(mp3|png|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
